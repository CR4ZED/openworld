{
  "format": "openworld-street-survey/1",
  "about": "Fields of the street survey. Shared by the phone form (viewer/survey.js) and the importer (tools/build_world.py). Every field is optional: leave anything you are unsure about empty.",
  "fields": [
    {
      "key": "width_m",
      "label": "Road width (metres)",
      "help": "Usable width between walls, or between the edges of the road if there are no walls.",
      "type": "number",
      "min": 1.5,
      "max": 40,
      "step": 0.1,
      "road_attr": "width_m"
    },
    {
      "key": "width_method",
      "label": "How was the width measured?",
      "type": "choice",
      "options": ["tape", "pacing", "estimate"]
    },
    {
      "key": "surface",
      "label": "Surface",
      "type": "choice",
      "options": ["tar (asphalt)", "concrete", "paving blocks", "gravel", "mud", "mixed or broken"],
      "road_attr": "surface"
    },
    {
      "key": "edges",
      "label": "Road edges",
      "type": "choice",
      "options": ["compound walls", "mud shoulder", "kerb", "open land", "mixed"]
    },
    {
      "key": "drain",
      "label": "Drain",
      "type": "choice",
      "options": [
        "none",
        "open, one side",
        "open, both sides",
        "covered, one side",
        "covered, both sides",
        "mixed"
      ],
      "road_attr": "drain"
    },
    {
      "key": "footpath",
      "label": "Footpath",
      "type": "choice",
      "options": ["none", "one side", "both sides"],
      "road_attr": "footpath"
    },
    {
      "key": "street_lights",
      "label": "Street lights",
      "type": "choice",
      "options": ["none", "few", "regular"]
    },
    {
      "key": "electric_poles",
      "label": "Electric poles",
      "type": "choice",
      "options": ["none", "one side", "both sides"]
    },
    {
      "key": "speed_breakers",
      "label": "Speed breakers (count)",
      "type": "integer",
      "min": 0,
      "max": 30
    },
    {
      "key": "potholes",
      "label": "Potholes",
      "type": "choice",
      "options": ["none", "some", "many"]
    },
    {
      "key": "water_logging",
      "label": "Water-logging in rain",
      "type": "choice",
      "options": ["no", "sometimes", "often"]
    },
    {
      "key": "trees",
      "label": "Trees along the road",
      "type": "choice",
      "options": ["none", "few", "many"]
    },
    {
      "key": "notes",
      "label": "Anything else",
      "help": "Shops, temple, school, cows usually here, cricket in the evening...",
      "type": "text",
      "max_length": 1000
    },
    {
      "key": "photos",
      "label": "Photo names",
      "help": "File names of the photos you will send (no faces or number plates).",
      "type": "text",
      "max_length": 500
    }
  ]
}
